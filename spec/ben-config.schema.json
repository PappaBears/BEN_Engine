{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schreiberai.com/schemas/ben-config.schema.json",
  "title": "BEN Engine configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "profile",
    "it_kw",
    "racks",
    "cooling",
    "redundancy",
    "climate"
  ],
  "properties": {
    "tier": {
      "enum": [
        "ben5",
        "ben30",
        "ben150",
        "ben500",
        "ben2000",
        "ben1",
        "ben300",
        "ben700",
        "micro",
        "ben10",
        "ben20",
        "ben40",
        "ben1000"
      ],
      "description": "Tier by nominal maximum IT kW. Rev 1: ben5/ben30/ben150/ben500/ben2000; Rev 2 adds ben1 (mini rack), ben300 and ben700 (liquid-first). Generation-1 keys micro/ben10/ben20/ben40 and the Rev 2 working name ben1000 (= ben700) are accepted as aliases"
    },
    "lineup": {
      "enum": [
        "rev1",
        "rev2"
      ],
      "default": "rev2",
      "description": "Product lineup. A saved configuration without this key is Rev 1 and reproduces exactly (docs/REVISION_POLICY.md rule 3)"
    },
    "form": {
      "enum": [
        "",
        "rack10",
        "cab12"
      ],
      "default": "",
      "description": "BEN 1 only: rack10 = 10-inch 8U desk / shelf rack (<= 0.6 kW), cab12 = 19-inch 12U sound-damped cabinet (<= 1.5 kW)"
    },
    "profile": {
      "enum": [
        "ai_inference",
        "ai_training",
        "private_cloud",
        "disaster_recovery",
        "industrial_ot",
        "healthcare",
        "public_sector",
        "off_grid"
      ]
    },
    "it_kw": {
      "type": "number",
      "minimum": 0.2,
      "maximum": 2000
    },
    "racks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    },
    "hardening": {
      "enum": [
        "H1",
        "H2",
        "H3",
        "IND"
      ],
      "description": "Enclosure hardening level: H1 standard IP66, H2 severe environment, H3 hardened/government; IND = BEN 1 indoor (no hardening levels)"
    },
    "cooling": {
      "enum": [
        "cabinet_dx",
        "inrow_dx",
        "inrow_dx_300",
        "rdhx_drycooler",
        "dlc_cdu",
        "dlc_hd",
        "office_air"
      ]
    },
    "redundancy": {
      "enum": [
        "N",
        "N+1",
        "2N"
      ]
    },
    "climate": {
      "enum": [
        "temperate",
        "hot_arid",
        "hot_humid",
        "cold",
        "coastal",
        "high_altitude"
      ]
    },
    "subsystems": {
      "type": "array",
      "items": {
        "enum": [
          "power",
          "cooling",
          "compute",
          "controls"
        ]
      },
      "uniqueItems": true
    },
    "white_label": {
      "type": "boolean"
    },
    "brand": {
      "type": "string",
      "maxLength": 40
    },
    "ups_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "generator": {
      "type": "boolean"
    },
    "site_name": {
      "type": "string",
      "maxLength": 80
    },
    "controls_tier": {
      "enum": [
        "auto",
        "lite",
        "pro",
        "mini"
      ],
      "description": "BEN Controls tier: auto (by size and profile), lite (Revolution Pi + Pods) or pro (PLCnext + UL 508A panel + edge computer + Pods)"
    },
    "power_architecture": {
      "enum": [
        "ac480",
        "dc800"
      ],
      "default": "ac480",
      "description": "Power distribution: ac480 (480 V AC -> UPS -> AC PDUs, today) or dc800 (800 VDC bus, AC/DC front end, battery on bus; BEN 150 and up; docs/FORWARD_ARCHITECTURE_DECISION.md)"
    },
    "dc_convention": {
      "enum": [
        "bipolar_400",
        "unipolar_800"
      ],
      "default": "bipolar_400",
      "description": "dc800 only: bipolar_400 (\u00b1400 VDC, high-resistance midpoint, OCP Diablo 400) or unipolar_800 (800 VDC, isolated return, OCP LVDC SST v0.3)"
    }
  },
  "x-tier-limits": {
    "ben5": {
      "it_kw_min": 2,
      "it_kw_max": 5,
      "max_racks": 1,
      "kind": "cabinet",
      "modules": 1,
      "rows": 1
    },
    "ben30": {
      "it_kw_min": 10,
      "it_kw_max": 30,
      "max_racks": 2,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben150": {
      "it_kw_min": 50,
      "it_kw_max": 150,
      "max_racks": 6,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben500": {
      "it_kw_min": 150,
      "it_kw_max": 500,
      "max_racks": 12,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben2000": {
      "it_kw_min": 800,
      "it_kw_max": 2000,
      "max_racks": 48,
      "kind": "hall",
      "modules": 3,
      "rows": 4
    },
    "ben1": {
      "it_kw_min": 0.2,
      "it_kw_max": 1.5,
      "max_racks": 1,
      "kind": "minirack",
      "modules": 1,
      "rows": 1
    },
    "ben300": {
      "it_kw_min": 150,
      "it_kw_max": 300,
      "max_racks": 2,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben700": {
      "it_kw_min": 400,
      "it_kw_max": 700,
      "max_racks": 5,
      "kind": "module",
      "modules": 1,
      "rows": 1
    }
  },
  "x-tier-aliases": {
    "micro": "ben5",
    "ben10": "ben30",
    "ben20": "ben150",
    "ben40": "ben500",
    "ben1000": "ben700"
  },
  "x-cooling-limits": {
    "cabinet_dx": {
      "max_rack_kw": 5,
      "medium": "air"
    },
    "inrow_dx": {
      "max_rack_kw": 30,
      "medium": "air"
    },
    "inrow_dx_300": {
      "max_rack_kw": 20,
      "medium": "air"
    },
    "rdhx_drycooler": {
      "max_rack_kw": 40,
      "medium": "water"
    },
    "dlc_cdu": {
      "max_rack_kw": 80,
      "medium": "liquid"
    },
    "dlc_hd": {
      "max_rack_kw": 250,
      "medium": "liquid"
    },
    "office_air": {
      "max_rack_kw": 1.5,
      "medium": "air"
    }
  },
  "x-power-architectures": {
    "ac480": {
      "tiers": [
        "ben5",
        "ben30",
        "ben150",
        "ben500",
        "ben2000",
        "ben1",
        "ben300",
        "ben700"
      ]
    },
    "dc800": {
      "tiers": [
        "ben150",
        "ben500",
        "ben2000",
        "ben300",
        "ben700"
      ]
    }
  },
  "x-dlc-hd-tiers": [
    "ben150",
    "ben500",
    "ben2000",
    "ben300",
    "ben700"
  ],
  "x-tiers-by-lineup": {
    "rev1": [
      "ben5",
      "ben30",
      "ben150",
      "ben500",
      "ben2000"
    ],
    "rev2": [
      "ben1",
      "ben5",
      "ben30",
      "ben150",
      "ben300",
      "ben500",
      "ben700",
      "ben2000"
    ]
  },
  "x-tier-limits-rev2": {
    "ben2000": {
      "it_kw_min": 1200,
      "it_kw_max": 2000,
      "max_racks": 15,
      "kind": "cluster",
      "modules": 3,
      "rows": 3
    }
  }
}