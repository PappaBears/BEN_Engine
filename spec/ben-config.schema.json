{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schreiberai.com/schemas/ben-config.schema.json",
  "title": "BEN Engine configuration",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tier",
    "profile",
    "it_kw",
    "racks",
    "cooling",
    "redundancy",
    "climate"
  ],
  "properties": {
    "tier": {
      "enum": [
        "ben5",
        "ben30",
        "ben150",
        "ben500",
        "ben2000",
        "micro",
        "ben10",
        "ben20",
        "ben40"
      ],
      "description": "Tier by nominal maximum IT kW (ben5/ben30/ben150/ben500/ben2000); generation-1 keys micro/ben10/ben20/ben40 are accepted as aliases"
    },
    "profile": {
      "enum": [
        "ai_inference",
        "ai_training",
        "private_cloud",
        "disaster_recovery",
        "industrial_ot",
        "healthcare",
        "public_sector",
        "off_grid"
      ]
    },
    "it_kw": {
      "type": "number",
      "minimum": 2,
      "maximum": 2000
    },
    "racks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 48
    },
    "hardening": {
      "enum": [
        "H1",
        "H2",
        "H3"
      ],
      "description": "Enclosure hardening level: H1 standard IP66, H2 severe environment, H3 hardened/government"
    },
    "cooling": {
      "enum": [
        "cabinet_dx",
        "inrow_dx",
        "inrow_dx_300",
        "rdhx_drycooler",
        "dlc_cdu"
      ]
    },
    "redundancy": {
      "enum": [
        "N",
        "N+1",
        "2N"
      ]
    },
    "climate": {
      "enum": [
        "temperate",
        "hot_arid",
        "hot_humid",
        "cold",
        "coastal",
        "high_altitude"
      ]
    },
    "subsystems": {
      "type": "array",
      "items": {
        "enum": [
          "power",
          "cooling",
          "compute",
          "controls"
        ]
      },
      "uniqueItems": true
    },
    "white_label": {
      "type": "boolean"
    },
    "brand": {
      "type": "string",
      "maxLength": 40
    },
    "ups_minutes": {
      "type": "integer",
      "minimum": 5,
      "maximum": 60
    },
    "generator": {
      "type": "boolean"
    },
    "site_name": {
      "type": "string",
      "maxLength": 80
    },
    "controls_tier": {
      "enum": [
        "auto",
        "lite",
        "pro"
      ],
      "description": "BEN Controls tier: auto (by size and profile), lite (Revolution Pi + Pods) or pro (PLCnext + UL 508A panel + edge computer + Pods)"
    }
  },
  "x-tier-limits": {
    "ben5": {
      "it_kw_min": 2,
      "it_kw_max": 5,
      "max_racks": 1,
      "kind": "cabinet",
      "modules": 1,
      "rows": 1
    },
    "ben30": {
      "it_kw_min": 10,
      "it_kw_max": 30,
      "max_racks": 2,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben150": {
      "it_kw_min": 50,
      "it_kw_max": 150,
      "max_racks": 6,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben500": {
      "it_kw_min": 150,
      "it_kw_max": 500,
      "max_racks": 12,
      "kind": "module",
      "modules": 1,
      "rows": 1
    },
    "ben2000": {
      "it_kw_min": 800,
      "it_kw_max": 2000,
      "max_racks": 48,
      "kind": "hall",
      "modules": 3,
      "rows": 4
    }
  },
  "x-tier-aliases": {
    "micro": "ben5",
    "ben10": "ben30",
    "ben20": "ben150",
    "ben40": "ben500"
  },
  "x-cooling-limits": {
    "cabinet_dx": {
      "max_rack_kw": 5,
      "medium": "air"
    },
    "inrow_dx": {
      "max_rack_kw": 30,
      "medium": "air"
    },
    "inrow_dx_300": {
      "max_rack_kw": 20,
      "medium": "air"
    },
    "rdhx_drycooler": {
      "max_rack_kw": 40,
      "medium": "water"
    },
    "dlc_cdu": {
      "max_rack_kw": 80,
      "medium": "liquid"
    }
  }
}