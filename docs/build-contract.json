{
  "version": 1,
  "source_paths": [
    "software",
    "tests",
    "firmware/ben-pod/lib",
    "firmware/ben-pod/src",
    "firmware/ben-pod/test",
    "firmware/ben-pod/Makefile",
    "web/assets",
    "dashboard/static",
    "purchasing/parts_catalog.json",
    "requirements.txt",
    "pyproject.toml"
  ],
  "checks": [
    {
      "id": "python-suite",
      "kind": "behavior",
      "command": [
        "env",
        "PYTHONPATH=software",
        "python3",
        "-m",
        "pytest",
        "tests",
        "-q",
        "--ignore=tests/e2e",
        "-p",
        "no:cacheprovider"
      ],
      "timeout_seconds": 600
    },
    {
      "id": "selector-parity",
      "kind": "integration",
      "command": [
        "env",
        "PYTHONPATH=software",
        "python3",
        "-m",
        "pytest",
        "tests/test_selector_parity.py",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "firmware-host-tests",
      "kind": "behavior",
      "command": [
        "make",
        "-C",
        "firmware/ben-pod",
        "test"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "commissioning-sim-e2e",
      "kind": "behavior",
      "command": [
        "env",
        "PYTHONPATH=software",
        "python3",
        "-m",
        "ben_engine.commissioning",
        "--sim",
        "--tier",
        "ben150",
        "--yes",
        "--out",
        ".schreiber-ai/commissioning-ben150.md"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "sweeps-ben500",
      "kind": "behavior",
      "command": [
        "env",
        "PYTHONPATH=software",
        "python3",
        "-m",
        "ben_engine.sweeps",
        "--tier",
        "ben500"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "audit-mechanical",
      "kind": "static",
      "command": [
        "python3",
        "scripts/audit.py"
      ],
      "timeout_seconds": 300
    },
    {
      "id": "links",
      "kind": "static",
      "command": [
        "python3",
        "scripts/check_links.py"
      ],
      "timeout_seconds": 120
    },
    {
      "id": "sim-e2e-pytest",
      "kind": "behavior",
      "command": [
        "env",
        "PYTHONPATH=software",
        "python3",
        "-m",
        "pytest",
        "tests/test_e2e.py",
        "-q",
        "-p",
        "no:cacheprovider"
      ],
      "timeout_seconds": 300
    }
  ]
}