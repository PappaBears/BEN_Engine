# BEN Engine gateway — environment for ben-api.service and scripts. Copy to /etc/ben/ben.env (mode 0640, root:ben).
BEN_UNIT=ben20-0007
BEN_MQTT_HOST=10.20.0.1
BEN_MQTT_PORT=1883
BEN_MQTT_USER=benapi
BEN_MQTT_PASS=change-me-at-install
BEN_DB=/var/lib/ben/ben.sqlite
BEN_RETENTION_DAYS=400
BEN_BACKUP_TARGET=/mnt/ben-backup        # USB stick or NAS mount (see install.sh)
BEN_BACKUP_KEEP=30
BEN_SIM=0                                 # 1 = run the digital twin instead of real nodes
