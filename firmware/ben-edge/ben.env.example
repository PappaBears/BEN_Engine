# BEN Engine edge computer — environment for ben-api.service, ben-plc-bridge.service and scripts.
# Copy to /etc/ben/ben.env (mode 0640, root:ben).
BEN_UNIT=ben20-0007
BEN_TIER=pro                              # pro (PLCnext + Karbon 400) | lite (RevPi software controller)
BEN_MQTT_HOST=10.30.0.1
BEN_MQTT_PORT=8884                        # management listener (password); the bridge uses the controls listener with its cert
BEN_MQTT_USER=benapi
BEN_MQTT_PASS=change-me-at-install
BEN_MQTT_CA=/etc/ben/pki/unit-ca.crt
BEN_MQTT_CERT=/etc/ben/pki/benapi.crt
BEN_MQTT_KEY=/etc/ben/pki/benapi.key
BEN_PLC_IP=10.20.0.10                     # PLCnext AXC F 2152 (pro) or 127.0.0.1 (lite: local software controller)
BEN_PLC_PORT=502
BEN_PLC_UNIT_ID=1
BEN_PLC_MAP=/etc/ben/modbus_map.csv       # same table as spec/PROTOCOL.md and firmware/ben-plc/modbus_map.csv
BEN_PLC_PROJECT_CRC=0x0000                # commissioned project CRC; mismatch -> plcN status attested:false
BEN_DB=/var/lib/ben/ben.sqlite
BEN_RETENTION_DAYS=400
BEN_BACKUP_TARGET=/mnt/ben-backup        # USB stick or NAS mount (see install.sh)
BEN_BACKUP_KEEP=30
BEN_SIM=0                                 # 1 = run the digital twin instead of real Pods/PLC
